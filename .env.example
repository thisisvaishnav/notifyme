# Telegram Bot Configuration
# Create your bot via @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Your personal Telegram chat ID or Channel/Group ID
# Retrieve via @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Optional separate Chat ID for operational and outage alerts (defaults to TELEGRAM_CHAT_ID)
TELEGRAM_ALERT_CHAT_ID=

# Dedicated X / Twitter Data Account Credentials (THROW-AWAY ACCOUNT ONLY!)
X_USERNAME=my_throwaway_account
X_EMAIL=throwaway@example.com
X_PASSWORD=YourSecurePassword123!
# Optional 2FA TOTP secret key if enabled on your X account
X_TOTP_SECRET=

# The numerical ID of your private X List containing tracked accounts
# e.g., from https://x.com/i/lists/1849123456789012345 -> 1849123456789012345
X_LIST_ID=1849123456789012345

# Location to store and reuse authentication cookies
X_COOKIES_PATH=data/cookies.json
