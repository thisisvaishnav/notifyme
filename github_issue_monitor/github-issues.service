[Unit]
Description=GitHub Issue Monitor Daemon
After=network.target

[Service]
Type=simple
User=notifyme
WorkingDirectory=/opt/notifyme
EnvironmentFile=/opt/notifyme/github_issue_monitor/.env
ExecStart=/opt/notifyme/github_issue_monitor/.venv/bin/python -m github_issue_monitor.main
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
